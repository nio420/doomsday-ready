model Cinema {
  id          String @id @default(cuid())
  name        String @unique
  bundleSizes Int[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Movie {
  id             String  @id @default(cuid())
  title          String  @unique
  releaseYear    Int
  runtimeMinutes Int
  watched        Boolean @default(false)

  prerequisites   Movie[] @relation("MoviePrerequisites")
  prerequisiteFor Movie[] @relation("MoviePrerequisites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
